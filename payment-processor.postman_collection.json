{
  "info": {
    "name": "Payment Processor API",
    "description": "Mini payment processor REST API (Rust + Actix Web). Base URL is configurable via the {{base_url}} collection variable (defaults to http://127.0.0.1:8080).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create client",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"client_name\": \"Jane Doe\",\n  \"birth_date\": \"1990-05-17\",\n  \"document_number\": \"30111222\",\n  \"country\": \"Argentina\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/new_client",
          "host": ["{{base_url}}"],
          "path": ["new_client"]
        },
        "description": "Registers a new client. document_number must be unique (409 on duplicates). Returns the generated client_id."
      },
      "response": [
        {
          "name": "201 Created",
          "originalRequest": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/new_client", "host": ["{{base_url}}"], "path": ["new_client"] }
          },
          "status": "Created",
          "code": 201,
          "_postman_previewlanguage": "json",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"client_id\": 1\n}"
        }
      ]
    },
    {
      "name": "Credit transaction",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"client_id\": 1,\n  \"credit_amount\": \"150.75\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/new_credit_transaction",
          "host": ["{{base_url}}"],
          "path": ["new_credit_transaction"]
        },
        "description": "Credits the client's account. Amount must be > 0 with at most 2 decimal places. Returns the new balance."
      },
      "response": [
        {
          "name": "200 OK",
          "originalRequest": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/new_credit_transaction", "host": ["{{base_url}}"], "path": ["new_credit_transaction"] }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"client_id\": 1,\n  \"balance\": \"150.75\"\n}"
        }
      ]
    },
    {
      "name": "Debit transaction",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"client_id\": 1,\n  \"debit_amount\": \"50.25\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/new_debit_transaction",
          "host": ["{{base_url}}"],
          "path": ["new_debit_transaction"]
        },
        "description": "Debits the client's account. Rejected with 422 if funds are insufficient. Returns the new balance."
      },
      "response": [
        {
          "name": "200 OK",
          "originalRequest": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/new_debit_transaction", "host": ["{{base_url}}"], "path": ["new_debit_transaction"] }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"client_id\": 1,\n  \"balance\": \"100.50\"\n}"
        },
        {
          "name": "422 Insufficient funds",
          "originalRequest": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/new_debit_transaction", "host": ["{{base_url}}"], "path": ["new_debit_transaction"] }
          },
          "status": "Unprocessable Entity",
          "code": 422,
          "_postman_previewlanguage": "json",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"error\": \"insufficient_funds\",\n  \"message\": \"insufficient funds: balance is 100.50, debit requested is 500.00\"\n}"
        }
      ]
    },
    {
      "name": "Store balances",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{base_url}}/store_balances",
          "host": ["{{base_url}}"],
          "path": ["store_balances"]
        },
        "description": "Persists all balances to DDMMYYYY_N.DAT (one '{client_id} {balance}' line per client), then resets every balance to zero in memory. N is a per-process atomic counter."
      },
      "response": [
        {
          "name": "200 OK",
          "originalRequest": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/store_balances", "host": ["{{base_url}}"], "path": ["store_balances"] }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"file_name\": \"22072026_1.DAT\",\n  \"clients_persisted\": 3\n}"
        }
      ]
    },
    {
      "name": "Client balance",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/client_balance?user_id=1",
          "host": ["{{base_url}}"],
          "path": ["client_balance"],
          "query": [
            { "key": "user_id", "value": "1" }
          ]
        },
        "description": "Returns the full client record plus current balance. 404 if the client does not exist."
      },
      "response": [
        {
          "name": "200 OK",
          "originalRequest": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/client_balance?user_id=1",
              "host": ["{{base_url}}"],
              "path": ["client_balance"],
              "query": [{ "key": "user_id", "value": "1" }]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"client_id\": 1,\n  \"client_name\": \"Jane Doe\",\n  \"birth_date\": \"1990-05-17\",\n  \"document_number\": \"30111222\",\n  \"country\": \"Argentina\",\n  \"balance\": \"100.50\"\n}"
        }
      ]
    }
  ]
}
